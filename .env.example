# 服务
HOST=127.0.0.1
PORT=9870
APP_ACCESS_CODE=

# 数据目录（SQLite、资产、导出）
DATA_DIR=./data

# 邮件（不配置时只生成预览）
# QQ 邮箱示例：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SSL=true
# SMTP_USER=你的QQ邮箱@qq.com
# SMTP_PASS=QQ邮箱授权码（不是QQ密码）
# SMTP_FROM=你的QQ邮箱@qq.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SSL=true
DAILY_EMAIL_ENABLED=false
DAILY_EMAIL_TIME=07:30

# 本机 OCR/ASR（可选；默认自动查找 ../scheduleDD/local-ai）
LOCAL_AI_DIR=
LOCAL_AI_ENGINE=
LOCAL_AI_PYTHON=
LOCAL_AI_MODELS=
FFMPEG_BIN=

# 可选的模型兜底（当前默认关闭，不影响规则抽取）
AGENT_LLM_ENABLED=false
AGENT_LLM_PROVIDER=anthropic
AGENT_LLM_BASE_URL=https://opencode.ai/zen/go
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-v4.1-flash
AGENT_LLM_PROTOCOL=anthropic
# 预留：OpenRouter 风格的模型列表/故障转移，后续再接
AGENT_LLM_FALLBACK_MODELS=
